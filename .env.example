# .env.example is a TEMPLATE for your real settings file.
# Copy it to a file named .env and fill in your own values.
# The real .env is never saved to GitHub (see .gitignore).

# ---- Django (the web app) ----

# A long random secret Django uses to protect logins. Make your own; never share it.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# 1 shows detailed error pages (good while building). Set to 0 for real use.
DJANGO_DEBUG=1

# The addresses people will use to reach TAKE IT, separated by commas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL (the database) ----

# The name of the database, the user that owns it, and that user's password.
POSTGRES_DB=takeit
POSTGRES_USER=takeit
POSTGRES_PASSWORD=change-me-too

# ---- Network ----

# The port on your computer where TAKE IT shows up (http://localhost:8000).
APP_PORT=8000
